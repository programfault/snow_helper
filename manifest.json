{
  "manifest_version": 3,
  "name": "SRE Helper",
  "version": "0.2.0",
  "description": "SRE toolkit: ServiceNow form automation, globe.com.ph info capture, remote services, token capture.",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Toggle SRE Helper side panel"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
